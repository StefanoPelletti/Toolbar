<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Application icon: sets the EXE icon, and the system tray picks it up
         via ExtractAssociatedIcon(ProcessPath) in App.xaml.cs. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Identity -->
    <Product>Toolbar</Product>
    <Company>Stefano Pelletti</Company>
    <Description>A minimal floating launcher toolbar for Windows</Description>
    <Copyright>© 2026 Stefano Pelletti</Copyright>
    <Version>1.3.4</Version>
    <AssemblyVersion>1.3.4.0</AssemblyVersion>
    <FileVersion>1.3.4.0</FileVersion>
  </PropertyGroup>

  <!-- WPF's pen/touch stack loads PenIMC_cor3.dll through its own native loader,
       which cannot find the DLL inside a single-file bundle. Any tablet re-scan
       (monitor power cycle, display driver upgrade) then throws DllNotFoundException
       per device, once per re-scan. Off, WPF never touches PenIMC: no stylus/touch
       events, but touch still arrives as mouse input, which is all the bar uses. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption
        Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport"
        Value="true" />
  </ItemGroup>

  <!-- Portable single-file release profile -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TrimmerRootDescriptor/>
  </PropertyGroup>

</Project>
